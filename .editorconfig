root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{csproj,fsproj,vbproj,props,targets,slnx,axaml,xaml,json,jsonc,yml,yaml,toml}]
indent_size = 2

[*.{ps1,psm1,psd1,bat,cmd}]
end_of_line = crlf

[*.{sh,bash,zsh}]
end_of_line = lf

[*.cs]
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_prefer_braces = true:error
csharp_new_line_before_open_brace = all
csharp_using_directive_placement = outside_namespace:error
dotnet_style_require_accessibility_modifiers = always:error
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.CA1062.severity = warning
dotnet_diagnostic.CA1305.severity = warning
dotnet_diagnostic.CA2007.severity = warning
dotnet_diagnostic.RAW101.severity = error
dotnet_diagnostic.RAW102.severity = error
dotnet_diagnostic.RAW110.severity = error
dotnet_diagnostic.RAW111.severity = error
dotnet_diagnostic.RAW120A.severity = warning
dotnet_diagnostic.RAW120B.severity = none
dotnet_diagnostic.RAW130.severity = error
dotnet_diagnostic.RAW140.severity = error
dotnet_diagnostic.RAW141.severity = error
