# テキストはOSに依存せずLFで正規化します。
* text=auto eol=lf

# C#／.NET
*.cs text eol=lf diff=csharp
*.csx text eol=lf diff=csharp
*.csproj text eol=lf
*.fsproj text eol=lf
*.vbproj text eol=lf
*.sln text eol=lf
*.slnx text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.ruleset text eol=lf
*.globalconfig text eol=lf
*.config text eol=lf
*.xml text eol=lf
*.resx text eol=lf
*.resw text eol=lf
*.xaml text eol=lf
*.axaml text eol=lf
*.nuspec text eol=lf
packages.lock.json text eol=lf

# 構成・データ・Web
*.json text eol=lf
*.jsonc text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.sql text eol=lf
*.graphql text eol=lf
*.gql text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf diff=html
*.htm text eol=lf diff=html
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# Shell。Windows batch／Windows PowerShell系だけCRLFを維持します。
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf

# 文書
*.md text eol=lf diff=markdown
*.markdown text eol=lf diff=markdown
*.mdx text eol=lf diff=markdown
*.txt text eol=lf
*.csv text eol=lf
*.tsv text eol=lf
README text eol=lf
LICENSE text eol=lf
NOTICE text eol=lf
CHANGELOG text eol=lf

# 上流ライセンスのハッシュ照合に使う原本は改行コードも保持します。
installer/ThirdParty/licenses/* -text

# unified diff の空行を表すスペースはパッチの書式として保持します。
eng/native-skia/msvc-headers.patch -whitespace

# Repository／tool設定
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.gitmodules text eol=lf
global.json text eol=lf
NuGet.Config text eol=lf
Dockerfile text eol=lf
*.dockerfile text eol=lf
Makefile text eol=lf

# 画像。SVGはテキストとして差分を確認します。
*.svg text eol=lf
*.jpg binary
*.jpeg binary
*.gif binary
*.png binary
*.bmp binary
*.tiff binary
*.ico binary
*.webp binary
*.psd binary
*.ai binary

