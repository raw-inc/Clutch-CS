# 生成コードは追跡しても通常diffの対象外とします。
*.designer.cs -diff
*.Designer.cs -diff
*.generated.cs -diff
*.Generated.cs -diff
*.g.cs -diff
*.g.i.cs -diff

# Source archiveに開発環境だけの設定を混ぜません。
.gitattributes export-ignore
.gitignore export-ignore
.github export-ignore
.vscode export-ignore
.vs export-ignore
.idea export-ignore
*.DotSettings export-ignore
*.DotSettings.user export-ignore
