<Project>
  <PropertyGroup>
    <VersionPrefix>0.2.2</VersionPrefix>
    <VersionSuffix>alpha</VersionSuffix>
    <VersionRevision>0</VersionRevision>
    <!-- CIから同じ製品版を明示した場合も修正番号を維持し、別版の指定には持ち込みません。 -->
    <AssemblyVersion Condition="'$(Version)' == '' or '$(Version)' == '$(VersionPrefix)-$(VersionSuffix)' or ('$(VersionSuffix)' == '' and '$(Version)' == '$(VersionPrefix)')">$(VersionPrefix).$(VersionRevision)</AssemblyVersion>
    <FileVersion Condition="'$(AssemblyVersion)' != ''">$(AssemblyVersion)</FileVersion>
  </PropertyGroup>
</Project>
