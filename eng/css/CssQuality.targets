<Project>
  <Target Name="VerifyContentsCssQuality" BeforeTargets="CoreCompile;PrepareForPublish"
          Condition="'$(MSBuildProjectName)' == 'ReArtWord.Contents.BackgroundService.Client' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <ContentsCssRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))</ContentsCssRoot>
    </PropertyGroup>
    <Error Condition="!Exists('$(ContentsCssRoot)/node_modules/stylelint/bin/stylelint.mjs')"
           Text="CSS検査の依存関係がありません。リポジトリルートで npm ci --ignore-scripts を実行してください。" />
    <Exec WorkingDirectory="$(ContentsCssRoot)" Command="node node_modules/stylelint/bin/stylelint.mjs &quot;src/**/*.css&quot; --max-warnings 0" />
  </Target>
</Project>
