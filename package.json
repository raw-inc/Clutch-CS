{
  "name": "reartword-contents-background-service",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build:code-editor": "node installer/Update-CodeEditorAssets.mjs",
    "test:code-editor": "node --test tests/ReArtWord.Contents.BackgroundService.Client.Tests/Client/code-editor.browser.mjs",
    "test:desktop": "node --test tests/ReArtWord.Contents.BackgroundService.Client.Tests/Client/remote-desktop*.browser.mjs",
    "test:files": "node --test tests/ReArtWord.Contents.BackgroundService.Client.Tests/Client/file-actions.browser.mjs",
    "test:pwa": "node --test tests/ReArtWord.Contents.BackgroundService.Client.Tests/Client/desktop-pwa.browser.mjs",
    "lint": "npm run lint:javascript && npm run lint:css",
    "lint:fix": "eslint . --fix --max-warnings 0 && stylelint \"src/**/*.css\" --fix --max-warnings 0",
    "test:lint": "node --test eng/javascript/tests/*.test.mjs",
    "test:javascript": "node --test tests/ReArtWord.Contents.BackgroundService.Client.Tests/Client/*.test.mjs",
    "verify:javascript": "npm run lint:javascript && npm run test:lint && npm run test:javascript",
    "lint:javascript": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings 0 && eslint \"src/**/*.{razor,html}\" --max-warnings 0",
    "test:css": "node --test eng/css/tests/*.test.mjs",
    "verify:css": "npm run lint:css && npm run test:css && npm run test:styles",
    "test:styles": "node --test tests/ReArtWord.Contents.BackgroundService.Client.Tests/Styles/*.test.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@eslint/js": "10.0.1",
    "@highlightjs/cdn-assets": "11.12.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@stylistic/stylelint-plugin": "5.3.0",
    "@types/node": "24.19.0",
    "acorn": "8.18.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "globals": "17.7.0",
    "parse5": "8.0.1",
    "playwright": "1.63.0",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "ws": "8.22.0"
  }
}
