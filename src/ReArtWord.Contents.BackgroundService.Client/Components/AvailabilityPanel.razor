@using ReArtWord.Contents.BackgroundService.Contracts.Persistence.Availability
@using ReArtWord.Contents.BackgroundService.Contracts.Persistence
<section class="section">
    <div class="section-heading"><h2>@Ui["Connected peer storage status"]</h2><button disabled="@busy" @onclick="()=>LoadAsync(false)"><UiIcon Name="refresh" />@Ui["Refresh"]</button></div>
    @if(message is not null){<p class="notice">@(message?.Invoke())</p>}
    @if(page is not null)
    {
        <p class="small muted">@Ui.Format("{0} / {1} · checked at {2}", cluster, peer, FormatTime(observed,"HH:mm:ss"))</p>
        <div class="table-wrap"><table><thead><tr><th>@Ui["Purpose / dataset"]</th><th>@Ui["Saved revision"]</th><th>@Ui["Effective revision"]</th><th>@Ui["Recovery revision"]</th><th>@Ui["Status"]</th></tr></thead><tbody>
        @foreach(var item in page.Entries)
        {
            <tr><td>@Ui[item.Purpose.ToString()]<small class="dataset-id" title="@item.DatasetId">@item.DatasetId</small></td><td class="mono" title="@item.SavedRevision">@Revision(item.SavedRevision)</td><td class="mono" title="@item.EffectiveRevision">@Revision(item.EffectiveRevision)</td><td class="mono" title="@item.RecoveryRevision">@Revision(item.RecoveryRevision)</td><td>@State(item)<small class="muted">@item.Reason</small></td></tr>
        }
        </tbody></table></div>
        @if(page.Entries.Count==0){<p class="empty">@Ui["This peer has no retained storage status."]</p>}
        @if(page.Cursor is not null){<button disabled="@busy" @onclick="()=>LoadAsync(true)">@Ui["Next page"]</button>}
        <details class="secondary-details"><summary>@Ui["Policies by purpose"]</summary>
        @foreach(var purpose in new[]{EStoragePurpose.Configuration,EStoragePurpose.Runtime})
        {
            var policy=page.Options.Purposes?.GetValueOrDefault(purpose)??new AvailabilityPolicy();
            <p><strong>@Ui[purpose.ToString()]</strong> · @Ui["On save failure"]: @(policy.SaveFailure==EAvailabilitySaveFailure.UseUnsaved?Ui["UseUnsaved"]:Ui["KeepConfirmed"]) · @Ui["When disconnected"]: @Ui[Offline(policy.Offline)] · @Ui["Fallback storage"]: @(policy.FallbackBackend?.ToString()??Ui["Not configured"])</p>
        }
        </details>
    }
</section>
