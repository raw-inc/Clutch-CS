<div @onkeydown:stopPropagation="true">
    <Modal Open="true" Wide="true" Title='@Ui["Select application executable"]' Close="Close">
        <div class="file-picker">
            <p class="small file-picker-owner">@Owner</p>
            <p class="small muted">@Ui["Open folders with a double-click or Enter. Select a file to use its absolute path."]</p>
            @if(problem is not null){<p class="notice error" role="alert">@problem()</p>}
            <div class="toolbar">
                <button type="button" class="quiet" disabled="@busy" @onclick="()=>LoadAsync(null,0,UiCancellation)"><UiIcon Name="drive" />@Ui["Drives"]</button>
                <button type="button" class="quiet" disabled="@(busy||directory is null)" @onclick="()=>LoadAsync(parent,0,UiCancellation)">@Ui["Parent folder"]</button>
                <button type="button" class="quiet" disabled="@busy" @onclick="()=>LoadAsync(directory,0,UiCancellation)"><UiIcon Name="refresh" />@Ui["Refresh"]</button>
            </div>
            <form class="file-picker-location" @onsubmit="()=>LoadAsync(string.IsNullOrWhiteSpace(address)?null:address.Trim(),0,UiCancellation)" @onsubmit:preventDefault="true">
                <input aria-label='@Ui["Folder path"]' @bind="address" @bind:event="oninput" disabled="@busy" placeholder='@Ui["Drives / enter a folder path"]' />
                <button type="submit" class="quiet" disabled="@busy">@Ui["Go to folder"]</button>
            </form>
            <div class="file-picker-list" aria-label='@Ui["Files and folders"]' aria-busy="@(busy?"true":"false")">
                @foreach(var entry in entries.OrderByDescending(item=>item.IsDirectory).ThenBy(item=>item.Name,StringComparer.CurrentCultureIgnoreCase))
                {
                    <div class="file-picker-row @(selected==entry?"selected":string.Empty)" @key="entry.Path">
                        <button type="button" class="quiet file-picker-name" disabled="@busy" aria-pressed="@(selected==entry?"true":"false")" title="@entry.Path"
                            @onclick="()=>selected=entry" @ondblclick="()=>OpenAsync(entry,UiCancellation)" @onkeydown="args=>KeyAsync(entry,args,UiCancellation)">
                            <UiIcon Name='@(entry.IsDirectory?(directory is null?"drive":"folder"):"file")' />@entry.Name
                        </button>
                        <span class="small muted">@Ui[entry.IsDirectory?"Folder":"File"]</span>
                    </div>
                }
                @if(busy){<p class="small muted" role="status">@Ui["Loading…"]</p>}
                else if(entries.Count==0&&problem is null){<p class="empty">@Ui["No files or folders found."]</p>}
            </div>
            @if(nextOffset is {} next){<button type="button" class="quiet" disabled="@busy" @onclick="()=>LoadAsync(directory,next,UiCancellation)">@Ui["More files"]</button>}
            <div class="file-picker-footer"><span class="small" title="@selected?.Path">@(selected?.Path??Ui["Select a file"])</span><button type="button" disabled="@(busy||selected is null||selected.IsDirectory)" @onclick="()=>ChooseAsync(UiCancellation)">@Ui["Use this file"]</button></div>
        </div>
    </Modal>
</div>
