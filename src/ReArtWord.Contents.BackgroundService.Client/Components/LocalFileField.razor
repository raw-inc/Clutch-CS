@using Microsoft.AspNetCore.Components.Forms
<label class="local-file-field">
    <span>@Label</span>
    <span class="file-picker-control"><span>@Ui["Choose a file"]</span><span>@(fileName ?? Ui["No file selected"])</span>
        <InputFile OnChange="args=>SelectAsync(args,UiCancellation)" accept="@Accept" disabled="@Disabled" aria-label="@Label" />
    </span>
</label>
