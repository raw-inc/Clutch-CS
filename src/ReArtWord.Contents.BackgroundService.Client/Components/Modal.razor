@if(Open)
{
    <dialog @ref="dialog" class="@(Wide?"dialog dialog-wide":"dialog")" aria-modal="true" data-confirm-discard="@(ConfirmDiscard ? string.Empty : null)" aria-label="@Ui[Title]" tabindex="-1" @onkeydown="KeyAsync" @onkeydown:stopPropagation="true">
        <div class="dialog-heading"><h2>@Ui[Title]</h2><button class="quiet icon-button" aria-label="@Ui["Close dialog"]" @onclick="()=>RequestCloseAsync(UiCancellation)"><UiIcon Name="close" /></button></div>
        <div class="dialog-content">@ChildContent</div>
        @if (Actions is not null)
        {
            <footer class="toolbar"><button type="button" @onclick="()=>RequestCloseAsync(UiCancellation)">@Ui["Cancel"]</button>@Actions</footer>
        }
        else if (ShowCloseAction)
        {
            <footer class="toolbar"><button type="button" @onclick="()=>RequestCloseAsync(UiCancellation)">@Ui["Close"]</button></footer>
        }
    </dialog>
}
