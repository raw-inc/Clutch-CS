@using ReArtWord.Contents.BackgroundService.Contracts.Observability

<Modal Open="true" Title="@Ui["Log tracing"]" Close="Close">
<ChildContent>
<section class="section trace-settings">
    <header class="review-heading">
        <div><h2>@Ui["Normal policy and temporary tracing"]</h2>
            <p class="small muted">@Ui["Clearing temporary tracing restores the saved normal policy. Saved and effective policies are shown separately."]</p></div>
        <button @onclick="RefreshAsync">@Ui["Get status"]</button>
    </header>
    <p class="notice" role="status">@(message?.Invoke())</p>
    @if(state is not null)
    {
        <div class="table-wrap"><table class="record-table trace-status">
            <thead><tr><th>@Ui["Workflow"]</th><th>@Ui["Saved normal"]</th><th>@Ui["Effective normal"]</th><th>@Ui["Current effective decision"]</th><th>@Ui["Temporary"]</th><th>@Ui["Retrieved"]</th></tr></thead>
            <tbody>
            @foreach(var item in state.States)
            {
                <tr>
                    <td class="trace-workflow"><strong>@item.WorkflowId</strong></td>
                    <td data-field="@Ui["Saved normal"]">@Flag(item.Saved.Enabled)</td>
                    <td data-field="@Ui["Effective normal"]">@Flag(item.ActiveNormal?.Enabled)</td>
                    <td data-field="@Ui["Current effective decision"]">@Flag(item.Effective.Enabled)</td>
                    <td data-field="@Ui["Temporary"]">@Flag(item.Temporary)</td>
                    <td data-field="@Ui["Retrieved"]"><span>@Flag(item.Loaded)@if(!string.IsNullOrWhiteSpace(item.Reason)){<small>@Ui[item.Reason]</small>}</span></td>
                </tr>
            }
            </tbody>
        </table></div>
        <label>@Ui["Target workflow"]<select @bind="workflow">@foreach(var item in state.States){<option value="@item.WorkflowId">@item.WorkflowId</option>}</select></label>
        <div class="trace-content-options">
            <label><input type="checkbox" @bind="inputs" />@Ui["Record inputs"]</label>
            <label><input type="checkbox" @bind="outputs" />@Ui["Record outputs"]</label>
            <label><input type="checkbox" @bind="raw" />@Ui["Record communication bodies and frames"]</label>
        </div>
        <label>@Ui["Leading bytes (empty means full content)"]<input type="text" inputmode="numeric" @bind="rawLimit" @bind:event="oninput" /></label>
        <p class="small muted">@Ui["With no content options selected, only metadata is recorded. Secrets remain redacted even in detailed tracing."]</p>
        @if(state.Closing.OperationId is Guid closing)
        {
            <p>@Ui.Format("Restart is on hold because of stop request {0}.", closing)</p>
            <button @onclick="ReleaseAsync">@Ui["Release only the restart hold"]</button>
            <p class="small muted">@Ui["Releasing this hold does not cancel an accepted host-stop request."]</p>
        }
        else
        {
            <div class="destructive-action">
                <p class="small muted">@Ui["Use this action to stop CoreService on the selected peers. Use Restore normal tracing to keep CoreService running."]</p>
                <button class="danger" @onclick="()=>stopOpen=true" disabled="@(!state.Loaded)"><UiIcon Name="stop" /><span class="control-label">@Ui["End temporary tracing and request CoreService stop"]</span></button>
            </div>
        }
        <JsonDetails Value="state" Title="@Ui["Trace scope and fixed targets"]" />
    }
</section>
</ChildContent>
<Actions>
    @if(state is not null)
    {
        <button @onclick="DisableAsync" disabled="@(!state.Loaded)">@Ui["Restore normal tracing"]</button>
        <button class="primary" @onclick="EnableAsync" disabled="@(!state.Loaded||state.Closing.OperationId is not null)">@Ui["Start temporary tracing"]</button>
    }
</Actions>
</Modal>
<Modal Open="stopOpen" Title="@Ui["Clear tracing and request cluster stop"]" Close="()=>stopOpen=false">
    <p>@Ui["Request stop for the displayed peer instances. Acceptance does not confirm every process has exited."]</p>
    <JsonDetails Value="state?.Targets" Title="@Ui["Instances fixed at the start"]" />
    <button @onclick="StopAsync">@Ui["Request stop for these instances"]</button>
</Modal>
