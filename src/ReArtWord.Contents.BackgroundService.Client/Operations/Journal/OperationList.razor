@using ReArtWord.Contents.BackgroundService.Client.Components
@using ReArtWord.Contents.BackgroundService.Client.Operations.Execution
<section class="section">
<h2>@Ui["Recorded operations and status queries"]</h2>
<div class="toolbar"><select aria-label="@Ui["Operation type"]" @bind="kind"><option value="capture">@Ui["Capture snapshot"]</option><option value="restore">@Ui["Restore snapshot"]</option><option value="file">@Ui["File operation across all targets"]</option><option value="update">@Ui["Release update"]</option><option value="run">@Ui["Manual run"]</option><option value="cancel">@Ui["Cancel execution"]</option><option value="save">@Ui["Save operation"]</option><option value="conflict">@Ui["Resolve shared state conflicts"]</option><option value="script-package">@Ui["script-package"]</option><option value="script-runtime">@Ui["script-runtime"]</option></select><input aria-label="@Ui["Known operation ID"]" @bind="identity" @bind:event="oninput" placeholder="@Ui["Operation GUID"]" /><button @onclick="LookupAsync">@Ui["Query known ID"]</button></div>
@if(problem is not null){<p class="notice error">@(problem?.Invoke())</p>}
<div class="table-wrap"><table>
<thead>
<tr>
<th>@Ui["Started / type"]</th>
<th>@Ui["Operation ID"]</th>
<th>@Ui["Fixed destination"]</th>
<th>@Ui["Last confirmed"]</th>
<th>@Ui["Progress by target"]</th>
<th>@Ui["Operation"]</th>
</tr>
</thead>
<tbody>
@foreach(var item in Journal.Items)
{
    <tr @key="item.OperationId">
<td>@FormatTime(item.CreatedAt) · @Ui[item.Kind]</td>
<td class="mono">@item.OperationId</td>
<td>@item.ClusterId / @item.PeerId</td>
<td>@Ui[OperationJournal.Outcome(item.Result)]</td>
<td>@foreach(var progress in Progress(item.Result)){<div class="small">@progress</div>}</td>
<td>
<button @onclick="()=>ReadResultAsync(item)">@Ui["Query again"]</button>@if(item.RecoverPath is not null){<button @onclick="()=>RecoverResultAsync(item)">@Ui["Recover the started restore"]</button>}<button @onclick="()=>DownloadAsync(item)">@Ui["Export original request"]</button>
@if(ReadRun(item) is {} run){<PcSelectionDetails Report="run.Report" />@if(run is {Running: true, OwnerInstanceId: Guid owner}){<RunCancelButton RunId="run.OperationId" OwnerInstanceId="owner" PeerId="@run.PeerId" ClusterId="@item.ClusterId" Completed="()=>ReadResultAsync(item)" />}}
<JsonDetails Value="item" />
</td>
</tr>
}
</tbody>
</table></div>
@if(Journal.LastOperation is not null){<p>@Ui["Operation"] @Journal.LastOperation · @Ui[OperationJournal.Outcome(Journal.LastResult)]</p>
<JsonDetails Value="Journal.LastResult" />}
</section>
