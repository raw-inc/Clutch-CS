@using ReArtWord.Contents.BackgroundService.Contracts.Processes
<section class="section applications-panel">
    <div class="section-heading"><h2>@Ui["Application groups"]</h2><button disabled="@(busy || !Available)" @onclick="()=>Edit(null)"><UiIcon Name="add" /><span class="control-label">@Ui["Create application group"]</span></button></div>
    <p class="small muted">@Ui["Combine registered applications on this PC and choose how to recover them."]</p>
    @if(message is not null){<p class="notice" role="status">@message()</p>}
    <clutch-status-labels><div class="table-wrap group-records"><table class="record-table"><thead><tr><th>@Ui["Application group name"]</th><th>@Ui["Group recovery policy"]</th><th>@Ui["Status"]</th><th>@Ui["Actions"]</th></tr></thead><tbody>
    @foreach(var item in groups)
    {
        <tr @key="item.Definition.Id"><td class="group-name" data-field="@Ui["Application group name"]"><div><strong>@item.Definition.Name</strong><div class="small muted">@string.Join(" → ",item.Definition.Members.Select(member=>Name(member.ApplicationId)))</div></div></td>
            <td class="group-policy" data-field="@Ui["Group recovery policy"]"><div>@Ui[Policy(item.Definition.RecoveryMode)]<div class="small muted">@Ui[item.Definition.AutomaticMonitoring?"Automatic monitoring":"Group automatic recovery disabled"]</div></div></td>
            <td class="group-state" data-field="@Ui["Status"]"><div><span data-status-label class="badge process-status">@Ui[Phase(item.Status)]</span>@if(item.Status.ApplicationId is {} active){<div>@Name(active)</div>}
                @if(item.Status.NextAt is {} due){<div class="small muted">@due.ToLocalTime().ToString("G",CultureInfo.CurrentCulture)</div>}
                @if(item.Status.Reason is {} reason){<div class="small error">@Ui[reason]</div>}
                @if(item.Status.Phase==EProcessGroupPhase.Paused){<p class="small">@Ui["Check the applications, resolve any unknown launch, then choose Start or Restart to continue."]</p>}
            </div></td>
            <td class="group-actions" data-field="@Ui["Actions"]"><div><div class="toolbar group-run-actions"><button disabled="@(busy||!Available||Active(item))" @onclick="()=>CommandAsync(item,EProcessGroupCommand.Start,UiCancellation)">@Ui["Start"]</button>
                <button class="restore-action" disabled="@(busy||!Available||Active(item))" @onclick="()=>Confirm(item,EProcessGroupCommand.Restart)"><UiIcon Name="refresh" /><span class="control-label">@Ui["Restart"]</span></button>
                <button class="danger" disabled="@(busy||!Available)" @onclick="()=>Confirm(item,EProcessGroupCommand.Stop)"><UiIcon Name="stop" /><span class="control-label">@Ui["Stop"]</span></button></div>
                <div class="toolbar group-edit-actions"><button disabled="@(busy||!Available||item.Status.Phase!=EProcessGroupPhase.Idle)" @onclick="()=>Edit(item)">@Ui["Edit"]</button><button class="danger" disabled="@(busy||!Available||Active(item))" @onclick="()=>removing=item"><UiIcon Name="trash" /><span class="control-label">@Ui["Remove group"]</span></button></div></div></td>
        </tr>
    }
    </tbody></table>@if(groups.Count==0){<div class="empty">@Ui["No application groups registered."]</div>}</div></clutch-status-labels>
</section>
<Modal Open="@(draft is not null)" Title='@Ui["Application group settings"]' Close="CloseEditor" ConfirmDiscard="true">
    <ChildContent>
    @if(draft is {} form)
    {
        <p class="small muted">@Owner</p>
        @if(message is not null){<p class="notice" role="status">@message()</p>}
        <fieldset class="group-settings-fields" disabled="@(busy||!Available)">
            <label>@Ui["Application group name"]<input maxlength="160" @bind="form.Name" @bind:event="oninput" /></label>
            <label><input type="checkbox" @bind="form.Automatic" />@Ui["Automatically recover this application group"]</label>
            <label>@Ui["Group recovery policy"]<select @bind="form.Mode"><option value="@EProcessGroupRecoveryMode.FailedApplications">@Ui[Policy(EProcessGroupRecoveryMode.FailedApplications)]</option><option value="@EProcessGroupRecoveryMode.EntireGroup">@Ui[Policy(EProcessGroupRecoveryMode.EntireGroup)]</option></select></label>
            @if(form.Mode==EProcessGroupRecoveryMode.EntireGroup){<label>@Ui["Group recovery delay (ms)"]<input type="number" min="0" max="3600000" @bind="form.RecoveryDelay" @bind:event="oninput" /><small>@Seconds(form.RecoveryDelay)</small></label>}
            <p class="small muted">@Ui["Recovery conditions and attempt limits follow each application's settings."]</p>
            <h3>@Ui["Group startup order"]</h3>
            <p class="small muted">@Ui["The first delay starts when group startup begins. Each later delay starts after the preceding application has started."]</p>
            @foreach(var member in form.Members)
            {
                <div class="card toolbar" @key="member.Id" data-member-id="@member.Id"><strong>@Name(member.Id)</strong><label>@Ui["Delay before this application starts (ms)"]<input type="number" min="0" max="3600000" @bind="member.Delay" @bind:event="oninput" /><small>@Seconds(member.Delay)</small></label>
                    <button class="quiet" aria-label='@Ui["Move application up"]' disabled="@(form.Members.IndexOf(member)==0)" @onclick="()=>form.Move(member,-1)">↑</button>
                    <button class="quiet" aria-label='@Ui["Move application down"]' disabled="@(form.Members.IndexOf(member)==form.Members.Count-1)" @onclick="()=>form.Move(member,1)">↓</button>
                    <button class="quiet" @onclick="()=>form.Members.Remove(member)">@Ui["Remove from group"]</button>
                </div>
            }
            <label>@Ui["Add a registered application"]<select value="" @onchange="Add"><option value="">@Ui["Select an application"]</option>@foreach(var application in Candidates()){<option value="@application.Id">@application.DisplayName</option>}</select></label>
            <label>@Ui["Group graceful stop timeout (ms)"]<input type="number" min="1" max="3600000" @bind="form.StopTimeout" @bind:event="oninput" /><small>@Seconds(form.StopTimeout)</small></label>
            <label>@Ui["If an application does not exit"]<select @bind="form.StopPolicy"><option value="@EProcessStopPolicy.WaitForManual">@Ui["Wait for manual action if it does not exit"]</option><option value="@EProcessStopPolicy.Force">@Ui["Force termination if it does not exit"]</option></select></label>

        </fieldset>
    }
    </ChildContent>
    <Actions>
        <button class="primary" disabled="@(busy||!Available||draft is null)" @onclick="()=>SaveAsync(UiCancellation)">@Ui["Save"]</button>
    </Actions>
</Modal>
<Modal Open="@(confirming is not null)" Title='@Ui[command==EProcessGroupCommand.Stop?"Stop group":"Restart group"]' Close="CloseConfirmation">
    <ChildContent>
        <p>@Owner · <strong>@confirming?.Definition.Name</strong></p>
        <p class="notice warning"><UiIcon Name="warning" /><span>@Ui[command==EProcessGroupCommand.Stop?"Stop all applications in this group and suspend group recovery.":"Stop all applications in this group, then restart them in the configured order."]</span></p>
        @if(confirming?.Definition.StopPolicy==EProcessStopPolicy.Force){<p>@Ui["Applications that do not exit within the configured timeout will be forcibly terminated."]</p>}
    </ChildContent>
    <Actions>
        <button class="@(command==EProcessGroupCommand.Stop?"danger confirm-action":"restore-action confirm-action")" disabled="@(busy||!Available)" @onclick="()=>CommandAsync(confirming!,command,UiCancellation)"><UiIcon Name="@(command==EProcessGroupCommand.Stop?"stop":"refresh")" /><span class="control-label">@Ui[command==EProcessGroupCommand.Stop?"Stop group":"Restart group"]</span></button>
    </Actions>
</Modal>
<Modal Open="@(removing is not null)" Title='@Ui["Remove group"]' Close="CloseRemoval">
    <ChildContent>
        <p>@Owner · <strong>@removing?.Definition.Name</strong></p>
        <p class="notice warning"><UiIcon Name="warning" /><span>@Ui["Remove the group only. Applications keep running and return to their individual monitoring settings."]</span></p>
        @if(message is not null){<p class="notice" role="status">@message()</p>}
    </ChildContent>
    <Actions>
        <button class="danger confirm-action" disabled="@(busy||!Available)" @onclick="()=>RemoveAsync(UiCancellation)"><UiIcon Name="trash" /><span class="control-label">@Ui["Remove group"]</span></button>
    </Actions>
</Modal>
