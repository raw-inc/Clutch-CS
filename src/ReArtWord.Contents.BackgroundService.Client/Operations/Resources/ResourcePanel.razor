@using ReArtWord.Contents.BackgroundService.Client.Components
@using ReArtWord.Contents.BackgroundService.Contracts.Resources
<section class="card">
<div class="section-heading"><h2>@Ui["Resources"]</h2><div class="toolbar"><button class="quiet" @onclick="RefreshAsync"><UiIcon Name="refresh" />@Ui["Refresh"]</button><button @onclick="HistoryAsync"><UiIcon Name="logs" />@Ui["Sample history"]</button></div></div>
@if(sample is not null){<p class="small muted">@sample.PeerId · @FormatTime(sample.ObservedAt)</p>
<div class="resource-metrics">@foreach(var name in new[]{"cpu.usage","memory.usage","memory.used"}){var metric=sample.Metrics.FirstOrDefault(item=>item.Name==name&&item.Target=="machine");<div>
<p class="metric-label">@Ui[name switch { "cpu.usage" => "CPU", "memory.usage" => "RAM", _ => "Used memory" }]</p>
<strong class="metric-number">@Value(metric)</strong>
</div>}</div>
<details>
<summary>@Ui["NIC, disk, GPU and collection details"]</summary>@foreach(var metric in sample.Metrics){<p class="port-row">@metric.Name / @metric.Target: @Value(metric)</p>}</details>@if(!sample.HistoryStored){<p>@Ui["History storage for this sample is unconfirmed."]</p>}}
<p class="notice">@(problem?.Invoke())</p>
</section>
<Modal Open="historyOpen" Title="@Ui["Saved resource samples"]" Close="()=>historyOpen=false">
<table>
<thead>
<tr>
<th>@Ui["Observed at"]</th>
<th>Peer</th>
<th>CPU</th>
<th>memory</th>
<th>@Ui["Details"]</th>
</tr>
</thead>
<tbody>@foreach(var item in history){<tr>
<td>@FormatTime(item.ObservedAt)</td>
<td>@item.PeerId</td>
<td>@Value(item.Metrics.FirstOrDefault(metric=>metric.Name=="cpu.usage"))</td>
<td>@Value(item.Metrics.FirstOrDefault(metric=>metric.Name=="memory.usage"))</td>
<td>
<JsonDetails Value="item" />
</td>
</tr>}</tbody>
</table>
</Modal>
