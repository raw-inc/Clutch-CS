@using ReArtWord.Contents.BackgroundService.Contracts.Scripting.Runtimes
<div class="runtime-picker">
    <div class="runtime-choice">
        <select aria-label="@Ui["Script runtime"]" value="@Value" disabled="@Disabled" @onfocus="()=>LoadAsync(false,UiCancellation)" @onchange="e=>SelectAsync(e,UiCancellation)">
            <option value="">@Ui["Default runtime"]@(catalog?.EffectivePath is {} effective ? " · " + effective : string.Empty)</option>
            @if(!string.IsNullOrWhiteSpace(Value) && catalog?.Entries.Any(entry=>entry.Path==Value)!=true)
            {
                <option value="@Value">@Value</option>
            }
            @foreach(var entry in catalog?.Entries ?? [])
            {
                <option value="@entry.Path" disabled="@(!entry.Available)">@EntryLabel(entry)</option>
            }
        </select>
        <button type="button" disabled="@(Disabled||busy||PeerId is null)" title="@Ui["Refresh runtime choices"]" @onclick="()=>LoadAsync(true,UiCancellation)"><UiIcon Name="refresh" /></button>
    </div>
    <details class="secondary-details">
        <summary>@Ui["Register an executable path"]</summary>
        <div class="runtime-choice">
            <input aria-label="@Ui["Runtime executable path"]" maxlength="4096" @bind="manual" @bind:event="oninput" disabled="@(Disabled||busy)" placeholder="@Value" />
            <button type="button" disabled="@(Disabled||busy||PeerId is null)" @onclick="()=>browse=true">@Ui["Browse"]…</button>
            <button type="button" disabled="@(Disabled||busy||string.IsNullOrWhiteSpace(manual)||PeerId is null)" @onclick="()=>RegisterAsync(UiCancellation)">@Ui["Register and select"]</button>
        </div>
    </details>
    @if(Manage)
    {
        <button type="button" disabled="@(Disabled||busy||catalog is null)" @onclick="()=>SetDefaultAsync(UiCancellation)">@Ui["Use selected runtime as default"]</button>
        @if(catalog is not null){<small>@Ui["Configured default"]: @(catalog.DefaultPath??Ui["Automatic detection"])</small>}
    }
    @if(problem is not null){<small class="error" role="status">@Ui[problem]</small>}
</div>
@if(browse && ClusterId is not null && PeerId is not null)
{
    <ReArtWord.Contents.BackgroundService.Client.Components.Files.HostFilePicker ClusterId="@ClusterId" PeerId="@PeerId" InitialPath="@manual" Owner="Script runtime" Picked="path=>PickedAsync(path,UiCancellation)" Close="()=>browse=false" />
}
