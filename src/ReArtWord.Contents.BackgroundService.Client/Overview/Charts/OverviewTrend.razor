<figure class="trend" title='@Ui["Actual samples from the last 5 minutes in this view. Gaps are not connected."]'>
    <span class="trend-scale">@ScaleLabel</span>
    <div class="trend-plot">
        <svg @ref="chart" viewBox="0 -2 300 104" preserveAspectRatio="none" role="img" aria-label="@Label">
            <path d="M0,0 H300 M0,50 H300 M0,100 H300" class="trend-grid" />
            <g data-series><path class="trend-line" /></g>
        </svg>
        @if (string.IsNullOrEmpty(path))
        {
            <small>@Ui["Collecting measured samples"]</small>
        }
    </div>
    <figcaption><span>@Ui["Five minutes ago"]</span><span>@Ui["Now"]</span></figcaption>
</figure>
