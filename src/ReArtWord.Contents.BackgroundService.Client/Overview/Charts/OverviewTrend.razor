@using ReArtWord.Contents.BackgroundService.Client.Overview.Telemetry
<figure data-card-inset class="trend @(Historical ? "historical" : null)" title='@Ui[Historical ? "Saved measurements before the last measurement" : "Actual samples from the last 5 minutes in this view. Gaps are not connected."]'>
    <div class="trend-scale"><span>@ScaleLabel</span>@if(!Historical && DashboardMetrics.IsUsage(Metric)){<span class="threshold-label">80 %</span>}</div>
    <div class="trend-plot">
        <svg @ref="chart" viewBox="0 -2 300 104" preserveAspectRatio="none" role="img" aria-label="@Label">
            <path d="M0,0 H300 M0,50 H300 M0,100 H300" class="trend-grid" />
            @if(!Historical && DashboardMetrics.IsUsage(Metric)){<path d="M0,20 H300" class="trend-threshold" />}
            <g data-series><path class="trend-line" /><path class="trend-line trend-highlight" aria-hidden="true" /></g>
        </svg>
        @if (string.IsNullOrEmpty(path))
        {
            <small>@Ui["Collecting measured samples"]</small>
        }
    </div>
    <figcaption>
        <span>@Ui["Five minutes ago"]</span>
        <span>@Ui[Historical?"Last measurement":"Now"]</span>
    </figcaption>
</figure>
