@using ReArtWord.Contents.BackgroundService.Client.Components
@using ReArtWord.Contents.BackgroundService.Contracts.Observability.Logging
<div class="log-export-control">
    <button @onclick="()=>StartAsync(ELogExportFormat.Log)" disabled="@(working || Disabled)"><UiIcon Name="save" />@Ui["log.export.textButton"]</button>
    <button @onclick="()=>StartAsync(ELogExportFormat.Zip)" disabled="@(working || Disabled)">@Ui["log.export.button"]</button>
    @if(working){<span class="small" role="status">@Ui.Format("log.export.progress", status?.Entries ?? 0)</span><button class="quiet" @onclick="CancelAsync">@Ui["Cancel"]</button>}
    @if(status?.State is "completed")
    {
        <span class="small" role="status">@Ui[status.Complete ? "log.export.complete" : status.Format == ELogExportFormat.Log ? "log.export.textPartial" : "log.export.partial"]</span>
    }
    @if(problem is not null){<span class="small" role="status">@problem()</span>}
</div>
