@using ReArtWord.Contents.BackgroundService.Client.Components
@using ReArtWord.Contents.BackgroundService.Client.Operations.Configuration
@using ReArtWord.Contents.BackgroundService.Client.Operations.Execution
@using ReArtWord.Contents.BackgroundService.Client.Operations.Journal
@using ReArtWord.Contents.BackgroundService.Client.Operations.Persistence
@using ReArtWord.Contents.BackgroundService.Client.Operations.Resources
@using ReArtWord.Contents.BackgroundService.Client.Operations.Snapshots
@using ReArtWord.Contents.BackgroundService.Client.Operations.Updates
@using ReArtWord.Contents.BackgroundService.Client.Operations.Scripting
@using ReArtWord.Contents.BackgroundService.Client.Overview.Updates
@page "/"
@page "/dashboard"
@using ReArtWord.Contents.BackgroundService.Contracts.Workflow
@using ReArtWord.Contents.BackgroundService.Contracts.Execution
@using ReArtWord.Contents.BackgroundService.Contracts.Configuration
@using ReArtWord.Contents.BackgroundService.Contracts.Management
@using ReArtWord.Contents.BackgroundService.Contracts.Nodes
@using ReArtWord.Contents.BackgroundService.Contracts.Cluster
@using ReArtWord.Contents.BackgroundService.Client.Overview
<main class="page dashboard-page">
    <div class="page-title"><h1>@Ui["Dashboard"]</h1><div class="toolbar"><button class="quiet" @onclick="RefreshAsync"><UiIcon Name="refresh" />@Ui["Refresh"]</button><button @onclick="()=>membershipOpen=true" disabled="@(!HasSelection)"><UiIcon Name="settings" />@Ui["Peer membership"]</button></div></div>
    @if(fleetUpdates is not null){<FleetUpdateBanner Updates="@fleetUpdates.Activities" OwnedOperations="@(fleetUpdates.Updates.Select(update=>update.OperationId).ToArray())" StaleOperations="@fleetUpdates.StaleOperations" Unavailable="@fleetUpdates.Unavailable" ShowDetails='()=>SelectViewAsync("Settings & maintenance")' />}
    <p class="notice" role="status">@Ui[message]</p>
    <div class="tabs" role="tablist" aria-label='@Ui["Dashboard views"]'>
        @foreach(var item in new[]{"All clusters","Peer list","Selected cluster","Execution & processes","Applications","Script packages","Snapshots","Resolve conflicts","Safety","Settings & maintenance","Operations"}){<button class="@(view==item?"active":string.Empty)" role="tab" aria-selected="@(view==item)" disabled="@(!HasSelection && item is not ("All clusters" or "Peer list" or "Settings & maintenance"))" @onclick="()=>SelectViewAsync(item)">@Ui[item]</button>}
    </div>
    <div hidden="@(view!="All clusters")"><AllClustersOverview @ref="allOverview" Active='@(view=="All clusters")' /></div>
    @if(view=="Peer list"){<PeerList @ref="peerList" />}
    <div hidden="@(view!="Selected cluster")">
        <DashboardOverview @ref="overview" Active='@(view=="Selected cluster")' />
        @if(!ListIsCurrent){<p class="footer-note">@Ui["Workflow and execution lists have not been retrieved for this connection."]</p>}
        <div hidden="@(!ListIsCurrent)">
        <section class="section"><div class="section-heading"><h2>@Ui["Workflows"]</h2><a class="small" href="/editor">@Ui["Open Editor →"]</a></div><div class="table-wrap"><table><thead><tr><th>@Ui["Name"]</th><th>@Ui["Activation"]</th><th>@Ui["Saved / effective revision"]</th><th>@Ui["Actions"]</th></tr></thead><tbody>
            @foreach(var item in workflows){<tr><td><a href="@("/editor?workflow="+Uri.EscapeDataString(item.Id!))">@item.Name</a><p class="small muted">@item.DetailReason</p></td><td><span class="badge @(item.EffectiveRevision==item.SavedRevision?"good":"warn")">@(item.LocalOnly ? Ui["Local · not shared"] : item.EffectiveRevision==item.SavedRevision ? Ui["Applied"] : Ui["Unapplied changes"])</span></td><td class="mono muted">@ShortRevision(item.SavedRevision)<br />@ShortRevision(item.EffectiveRevision)</td><td><button @onclick="()=>RunAsync(item)" disabled="@(item.Id is null)"><UiIcon Name="play" />@Ui["Run once"]</button>@if(item.EffectiveRevision!=item.SavedRevision){<button @onclick="()=>activation=item" disabled="@(item.Id is null)">@Ui["Apply saved revision"]</button>}</td></tr>}
        </tbody></table>@if(workflows.Count==0){<div class="empty"><UiIcon Name="nodes" />@Ui["No saved workflows."]</div>}</div>@if(workflowCursor is not null){<button class="section" @onclick="NextWorkflowsAsync">@Ui["Next workflow page"]</button>}</section>
        <details class="secondary-details"><summary>@Ui["Recent executions"] <span class="count">@executions.Count</span></summary>@foreach(var execution in executions){<details><summary>@FormatTime(execution.Report?.StartedAt??execution.Summary?.StartedAt) · @(execution.Report?.WorkflowId??execution.Summary?.WorkflowId) · @(execution.Report?.Outcome??execution.Summary?.Outcome)</summary><p class="notice">@execution.DetailReason</p><PcSelectionDetails Report="execution.Report" /><JsonDetails Value="execution" /></details>}@if(executionCursor is not null){<button @onclick="NextExecutionsAsync">@Ui["Next execution page"]</button>}</details>
        </div>
    </div>
    @if(view=="Execution & processes" && HasSelection){<div class="dashboard-operations">
        <ActiveRunsPanel @key="(Api.SelectedClusterId, Api.SelectedPeerId, Connection.Current?.InstanceId)" />
        @if(Connection.Current is {} running)
        {
            <div class="execution-telemetry">
            @if(running.Schedules is {} schedules)
            {
                <p class="footer-note">@Ui.Format("Retained scheduled inputs: {0}; results awaiting confirmation: {1}.", schedules.LocallyManagedInputs, schedules.UnconfirmedResults)</p>
            }
            @if(running.ScheduleProblem is {} scheduleProblem)
            {
                <p class="footer-note">@Ui["Last schedule problem"]: @scheduleProblem</p>
            }
            @if(running.Events is {} eventStats)
            {
                <p class="footer-note">@Ui.Format("Hooks: {0} subscriptions, {1} events, {2} dropped deliveries, {3} omitted values.", eventStats.Subscribers, eventStats.Published, eventStats.DroppedDeliveries, eventStats.OmittedValues) @eventStats.LastProblem</p>
            }
            </div>
            <section><div class="section-heading"><h2>@Ui["Sources"]</h2><span>@Ui["Manage listening sources"]</span></div><div class="table-wrap"><table><thead><tr><th>Workflow / Node</th><th>@Ui["State"]</th><th>@Ui["Reason"]</th><th>@Ui["Actions"]</th></tr></thead><tbody>@foreach(var source in running.Sources){<tr><td>@source.WorkflowId / @source.NodeId</td><td>@source.Status.State</td><td>@source.Status.ReasonCode</td><td><button disabled="@(!source.CanStop)" @onclick="()=>StopSourceAsync(source,false)">@Ui["Stop intake"]</button><button disabled="@(!source.CanStop)" @onclick="()=>StopSourceAsync(source,true)">@Ui["Cancel accepted work too"]</button></td></tr>}</tbody></table>@if(running.Sources.Count==0){<div class="empty">@Ui["No listening sources."]</div>}</div><p class="footer-note">@Ui["Stopping intake allows accepted work to finish. It does not confirm or undo external side effects."]</p></section>
        }
        <div class="section"><ResourcePanel @ref="resourcePanel" /></div>
    </div>}
    @if(view=="Applications" && HasSelection){<div class="dashboard-operations"><ProcessPanel @ref="processPanel" @key="(Api.SelectedClusterId, Api.SelectedPeerId)" /></div>}
    @if(view=="Script packages" && HasSelection){<div class="dashboard-operations"><ScriptPackagePanel @key="(Api.SelectedClusterId, Api.SelectedPeerId, Connection.Current?.InstanceId)" /></div>}
    @if(view=="Snapshots" && HasSelection){<div class="dashboard-operations"><SnapshotPanel /></div>}
    @if(view=="Resolve conflicts" && HasSelection){<div class="dashboard-operations"><ConflictPanel /><DetachedWorkflowPanel /></div>}
    @if(view=="Safety" && HasSelection){<div class="dashboard-operations"><SafetyPanel /></div>}
    @if(view=="Settings & maintenance"){<div class="dashboard-operations"><DisplaySettingsPanel /><ExperimentalSettingsPanel />@if(fleetUpdates is not null){<FleetUpdatePanel Updates="@fleetUpdates.Updates" ProgressUnavailable="@fleetUpdates.Unavailable" RefreshProgress="RefreshAsync" />}</div>}
    @if(view=="Settings & maintenance" && HasSelection){<div class="dashboard-operations"><ConfigurationPanel /><details class="secondary-details"><summary>@Ui["Inspect and edit internal data"]</summary><InternalDataPanel /></details><details class="secondary-details"><summary>@Ui["Application updates"]</summary><UpdatePanel /></details><details class="secondary-details"><summary>@Ui["Connection secrets"]</summary><div class="toolbar"><button @onclick="SecretsAsync">@Ui["List registered names"]</button><button @onclick="()=>secretOpen=true">@Ui["Register a secret"]</button></div>@if(secretNames.Count!=0){<p>@string.Join(", ",secretNames)</p>}</details></div>}
    @if(view=="Operations" && HasSelection){<div class="dashboard-operations"><OperationList /></div>}
    @if(result is not null){<JsonDetails Value="result" Title='@Ui["Actual operation result"]' />}
</main>
<Modal Open="membershipOpen" Title='@Ui["Peer membership"]' Close="()=>membershipOpen=false"><p>@Ui.Format("Target: {0}",Connection.Current?.PeerId)</p><p class="muted">@Ui["A detached peer stays outside normal cluster execution until explicitly rejoined."]</p><div class="toolbar"><button @onclick="DetachAsync">@Ui["Detach this peer"]</button><button @onclick="RejoinAsync">@Ui["Rejoin"]</button></div></Modal>
<Modal Open="(activation is not null)" Title='@Ui["Apply saved revision to future inputs"]' Close="()=>activation=null">
@if(activation is not null){<ConfigurationImpactPanel @key="(activation.Id,activation.SavedRevision,Api.SelectedClusterId,Api.SelectedPeerId)" WorkflowId="@(activation.Id!)" Revision="@activation.SavedRevision" Changed="value=>activationImpact=value" />}
<p>@Ui.Format("Use the saved revision of {0}. Started work keeps its original revision.",activation?.Name)</p>
<button @onclick="ActivateAsync" disabled="@(activationImpact is null)">@Ui["Confirm impact and apply"]</button>
</Modal>
<Modal Open="secretOpen" Title='@Ui["Save a secret"]' Close="CloseSecret">
<label>@Ui["Reference name"]<input @bind="secretName" @bind:event="oninput" />
</label>
<label>@Ui["Secret value"]<input type="password" autocomplete="new-password" @bind="secretValue" @bind:event="oninput" />
</label>
<button @onclick="SaveSecretAsync">@Ui["Save and share"]</button>
</Modal>
