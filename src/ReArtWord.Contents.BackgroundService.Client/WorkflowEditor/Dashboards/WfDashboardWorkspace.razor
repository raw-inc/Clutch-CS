@using ReArtWord.Contents.BackgroundService.Client.WorkflowEditor.Documents
@using ReArtWord.Contents.BackgroundService.Client.WorkflowEditor.Navigation
@using ReArtWord.Contents.BackgroundService.Client.Operations.Journal
@using ReArtWord.Contents.BackgroundService.Contracts.Workflow.Dashboards
@inject EditorDocument Model
@inject ManagementApi Api
@inject ConnectionState Connection
@inject OperationJournal Journal
@inject EditorNoticeHub Notices
@inject IJSRuntime JS
<div class="dashboard-heading">
    <div class="toolbar">
        <UiIcon Name="dashboard" /><span class="muted small">WFDashboard</span>
        <button class="quiet icon-button" type="button" aria-label="@Ui["Open workflow"]" @onclick="Open"><UiIcon Name="chevron" /></button>
        <input class="dashboard-name" aria-label="@Ui["WFDashboard name"]" value="@Model.Draft.Document.Name" disabled="@LayoutLocked" @oninput="e=>Model.Change(document=>document with{Name=e.Value?.ToString()??string.Empty})" />
        <small class="muted">@Ui[Model.Draft.BaseRevision is null?"New · unsaved":Model.Draft.Dirty?"Unsaved":"Saved and shared"]</small>
        <span class="toolbar-spacer"></span>
        <button type="button" class="quiet" @onclick="()=>catalogOpen=!catalogOpen"><UiIcon Name="add" />@Ui["Add reference"]</button>
        <button type="button" class="quiet" disabled="@LayoutLocked" @onclick="()=>AddCard(WfDashboardLayout.CommentType,WfDashboardLayout.CommentSettings(string.Empty))">@Ui["Add comment"]</button>
        <button type="button" class="quiet" disabled="@LayoutLocked" @onclick="()=>AddCard(WfDashboardLayout.BreakType,WfDashboardLayout.BreakSettings())">@Ui["Add line break"]</button>
        <button type="button" class="quiet icon-button" title="@Ui["Undo"]" aria-label="@Ui["Undo"]" disabled="@(LayoutLocked||!Model.CanUndo)" @onclick="Model.Undo"><UiIcon Name="undo" /></button>
        <button type="button" class="primary" disabled="@(LayoutLocked||Model.Draft.Conflicts.Count!=0)" @onclick="Save"><UiIcon Name="save" />@Ui["Save"]</button>
        <button type="button" class="quiet icon-button" aria-label="@Ui["More actions"]" @onclick="Tools"><UiIcon Name="more" /></button>
    </div>
</div>
<div class="dashboard-workspace @(catalogOpen?"with-catalog":null)">
    @if(catalogOpen){<aside class="dashboard-library"><WfDashboardStatePicker Added="reference=>AddCard(WfDashboardStateReference.CardType,reference.ToSettings())" /><WfDashboardCatalogPanel Add="AddCard" Close="()=>catalogOpen=false" /></aside>}
    <WfDashboardStateFeed Nodes="Cards" Cluster="@Model.ClusterId" Peer="@Model.PeerId" Instance="@(Connection.Connected?Connection.Current?.InstanceId:null)" Context="stateFeed">
    <section @ref="board" class="dashboard-board" aria-label="WFDashboard" @ondrop:preventDefault="true" @ondrop="DropAsync">
        <div class="dashboard-cards">
            @foreach(var card in Cards)
            {
                var reference=Reference(card);
                var stateReference=WfDashboardStateReference.Read(card);
                var state=reference is null?null:session.Find(reference);
                var comment=card.Type==WfDashboardLayout.CommentType;
                var lineBreak=card.Type==WfDashboardLayout.BreakType;
                <article @key="card.Id" class="dashboard-card @(reference?.NodeType is "control.concurrencyLimit"?"concurrency-card":null) @(lineBreak?"dashboard-line-break":null) @(dropTarget==card.Id&&dragged!=card.Id?"drop-target":null)" data-card-id="@card.Id" @ondragenter="()=>dropTarget=card.Id">
                    <header draggable="@(!LayoutLocked?"true":"false")" data-contents-dashboard-card="@card.Id" @ondragstart="()=>dragged=LayoutLocked?null:card.Id" @ondragend="()=>dragged=dropTarget=null" title="@(reference is null?null:state?.WorkflowName+" / "+reference.NodeId)">
                        <strong>@(comment?Ui["Dashboard comment"]:lineBreak?Ui["Dashboard line break"]:stateReference?.Target.Key??state?.Title??reference?.NodeId??Ui["Invalid reference"])</strong>
                        <button class="quiet icon-button" type="button" aria-label="@Ui[comment||lineBreak?"Remove card":"Remove reference"]" title="@Ui[comment||lineBreak?"Remove card":"Remove reference"]" disabled="@LayoutLocked" @onclick="()=>RemoveCard(card.Id)"><UiIcon Name="close" /></button>
                    </header>
                    @if(comment){<WfDashboardComment Node="card" Locked="LayoutLocked" />}
                    else if(stateReference is not null){<WfDashboardStateCard Reference="stateReference" State="stateFeed.Find(card.Id)" Problem="@stateFeed.Problem" />}
                    else if(!lineBreak)
                    {
                        @if(reference is null){<p class="notice warn">@Ui["Invalid reference"]</p>}
                        else{<WfDashboardCard Reference="reference" State="state" Cluster="@Model.ClusterId" Available="CanOperate" Busy="pending.Contains(card.Id)" Toggle="session.Toggle(reference)" Snapshots="session.Preview(Model.ClusterId??string.Empty,reference)" Pressed="()=>PressAsync(card)" ValueChanged="input=>SaveValueAsync(card,input)" />}
                    }
                </article>
            }
        </div>
        @if(Cards.Length==0){<div class="dashboard-empty"><UiIcon Name="dashboard" /><p>@Ui["Add supported nodes from workflows in this cluster."]</p><button type="button" @onclick="()=>catalogOpen=true">@Ui["Add reference"]</button></div>}
        <div class="dashboard-notifications"><EditorNotifications Compact="true" /></div>
    </section>
    </WfDashboardStateFeed>
</div>
