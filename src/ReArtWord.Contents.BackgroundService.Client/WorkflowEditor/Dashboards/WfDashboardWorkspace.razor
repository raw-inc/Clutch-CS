@using ReArtWord.Contents.BackgroundService.Client.WorkflowEditor.Documents
@using ReArtWord.Contents.BackgroundService.Client.WorkflowEditor.Navigation
@using ReArtWord.Contents.BackgroundService.Client.Operations.Journal
@using ReArtWord.Contents.BackgroundService.Contracts.Workflow.Dashboards
@inject EditorDocument Model
@inject ManagementApi Api
@inject ConnectionState Connection
@inject OperationJournal Journal
@inject EditorNoticeHub Notices
@inject IJSRuntime JS
<div class="dashboard-heading">
    <div class="toolbar">
        <span class="muted small">WFDashboard</span>
        <button class="icon-button" type="button" aria-label="@Ui["Open workflow"]" @onclick="Open"><UiIcon Name="dashboard" /><UiIcon Name="chevron" /></button>
        <input readonly="@(!editingLayout)" class="dashboard-name" aria-label="@Ui["WFDashboard name"]" value="@Model.Draft.Document.Name" disabled="@LayoutLocked" @oninput="e=>Model.Change(document=>document with{Name=e.Value?.ToString()??string.Empty})" />
        <small class="save-state"><span class="dot"></span>@Ui[Model.Draft.BaseRevision is null?"New · unsaved":Model.Draft.Dirty?"Unsaved":"Saved and shared"]</small>
    </div>
    <div class="toolbar dashboard-edit-tools">
        @if(!editingLayout){<button type="button" @onclick="()=>editingLayout=true">@Ui["Edit board layout"]</button>}
        @if(editingLayout)
        {
        <button type="button" aria-expanded="@(catalogOpen?"true":"false")" @onclick="()=>catalogOpen=!catalogOpen"><UiIcon Name="add" /><span class="control-label">@Ui["Add reference"]</span></button>
        <button type="button" disabled="@LayoutLocked" @onclick="()=>AddCard(WfDashboardLayout.CommentType,WfDashboardLayout.CommentSettings(string.Empty))">@Ui["Add comment"]</button>
        <button type="button" disabled="@LayoutLocked" @onclick="()=>AddCard(WfDashboardLayout.BreakType,WfDashboardLayout.BreakSettings())">@Ui["Add line break"]</button>
        <button type="button" class="icon-button" title="@Ui["Undo"]" aria-label="@Ui["Undo"]" disabled="@(LayoutLocked||!Model.CanUndo)" @onclick="Model.Undo"><UiIcon Name="undo" /></button>
        <button type="button" title='@Ui["Layout edits remain in the draft until saved."]' @onclick="()=>{editingLayout=false;catalogOpen=false;}">@Ui["Finish layout editing"]</button>
        <button type="button" class="primary" disabled="@(LayoutLocked||Model.Draft.Conflicts.Count!=0)" @onclick="Save"><UiIcon Name="save" /><span class="control-label">@Ui["Save"]</span></button>
        }
        <button type="button" class="icon-button" aria-label="@Ui["More actions"]" @onclick="Tools"><UiIcon Name="more" /></button>
    </div>
</div>
<div class="dashboard-workspace @(catalogOpen?"with-catalog":null)">
    @if(catalogOpen){<aside class="dashboard-library"><WfDashboardCatalogPanel Add="AddCard" Close="()=>catalogOpen=false" /><WfDashboardStatePicker Added="reference=>AddCard(WfDashboardStateReference.CardType,reference.ToSettings())" /></aside>}
    <WfDashboardStateFeed Nodes="Cards" Cluster="@Model.ClusterId" Peer="@Model.PeerId" Instance="@(Connection.Connected?Connection.Current?.InstanceId:null)" Context="stateFeed">
    <clutch-scroll-area class="dashboard-board-scroll"><section @ref="board" class="dashboard-board" aria-label="WFDashboard" @ondrop:preventDefault="true" @ondrop="DropAsync">
        <clutch-card-rows data-balance-short-cards><div class="dashboard-cards">
            @foreach(var card in Cards)
            {
                var reference=Reference(card);
                var stateReference=WfDashboardStateReference.Read(card);
                var state=reference is null?null:session.Find(reference);
                var comment=card.Type==WfDashboardLayout.CommentType;
                var lineBreak=card.Type==WfDashboardLayout.BreakType;
                <article @key="card.Id" class="dashboard-card @(reference?.NodeType is "control.concurrencyLimit"?"concurrency-card":null) @(lineBreak?"dashboard-line-break":null) @(dropTarget==card.Id&&dragged!=card.Id?"drop-target":null)" data-card-id="@card.Id" @ondragenter="()=>dropTarget=card.Id">
                    <header draggable="@(editingLayout&&!LayoutLocked?"true":"false")" data-contents-dashboard-card="@card.Id" @ondragstart="()=>dragged=(!editingLayout||LayoutLocked)?null:card.Id" @ondragend="()=>dragged=dropTarget=null" title="@(reference is null?null:state?.WorkflowName+" / "+reference.NodeId)">
                        <strong>@(comment?Ui["Dashboard comment"]:lineBreak?Ui["Dashboard line break"]:stateReference?.Target.Key??state?.Title??reference?.NodeId??Ui["Invalid reference"])</strong>
                        @if(editingLayout){<button class="quiet icon-button" type="button" aria-label="@Ui[comment||lineBreak?"Remove card":"Remove reference"]" title="@Ui[comment||lineBreak?"Remove card":"Remove reference"]" disabled="@LayoutLocked" @onclick="()=>RemoveCard(card.Id)"><UiIcon Name="close" /></button>}
                    </header>
                    @if(comment){<WfDashboardComment Node="card" Locked="@(LayoutLocked||!editingLayout)" />}
                    else if(stateReference is not null){<WfDashboardStateCard Reference="stateReference" State="stateFeed.Find(card.Id)" Problem="@stateFeed.Problem" />}
                    else if(!lineBreak)
                    {
                        @if(reference is null){<p class="notice warn">@Ui["Invalid reference"]</p>}
                        else{<WfDashboardCard Reference="reference" State="state" Cluster="@Model.ClusterId" Available="CanOperate" EditingLayout="editingLayout" Busy="pending.Contains(card.Id)" Toggle="session.Toggle(reference)" Snapshots="session.Preview(Model.ClusterId??string.Empty,reference)" Pressed="()=>PressAsync(card)" ValueChanged="input=>SaveValueAsync(card,input)" />}
                    }
                    @if(lastPress.TryGetValue(card.Id,out var pressed)){<small role="status">@pressed</small>}
                    else if(!editingLayout && reference?.NodeType is "control.button" or "control.toggleButton"){<small class="muted board-action-note">@Ui["No action recorded on this page."]</small>}
                </article>
            }
        </div></clutch-card-rows>
        @if(Cards.Length==0 && editingLayout){<div class="dashboard-empty"><UiIcon Name="dashboard" /><p>@Ui["Add supported nodes from workflows in this cluster."]</p><button type="button" @onclick="()=>catalogOpen=true">@Ui["Add reference"]</button></div>}
        <div class="dashboard-notifications"><EditorNotifications Compact="true" /></div>
    </section></clutch-scroll-area>
    </WfDashboardStateFeed>
</div>
