@using ReArtWord.Contents.BackgroundService.Client.Components
@using ReArtWord.Contents.BackgroundService.Contracts.Execution
@using ReArtWord.Contents.BackgroundService.Contracts.Configuration.Workflows
<Modal Open="Open" Compact="true" Title="@Ui["Force save current draft"]" Close="()=>CloseAsync(UiCancellation)">
    <ChildContent>
    @if(force?.Review is {} review)
    {
        <p><strong>@review.Draft.Document.Name</strong> · <code>@review.Draft.Document.Id</code><br />@review.Cluster / @review.Peer</p>
        <p class="notice warning"><UiIcon Name="warning" /><span>@Ui["Save this draft without waiting for collaborative reconciliation. The latest saved version will be replaced, then the confirmed conflict choices will be synchronized."]</span></p>
    }
    <div class="force-save-version">
        @if(force?.Review is {} confirmed)
        {
            <div>
                <strong>@Ui["Saved revision"]</strong>
                @if(confirmed.Saved is {} saved)
                {
                    <div class="force-save-version-value"><time datetime="@saved.SavedAt.ToString("O", CultureInfo.InvariantCulture)">@FormatTime(saved.SavedAt,"yyyy-MM-dd HH:mm:ss zzz")</time><code>@AbbreviatedRevision(saved.Revision)</code></div>
                }
                else
                {
                    <p>@Ui["Not saved"]</p>
                }
            </div>
        }
        <button disabled="@working" @onclick="()=>PrepareAsync(UiCancellation)">@Ui["Review latest version"]</button>
    </div>
    @if(force?.Review is {} comparison)
    {
        <dl class="force-save-facts">
            <dt>@Ui["Node count"]</dt><dd>@(comparison.Saved?.Definition.Nodes.Count??0) → @comparison.Draft.Document.Nodes.Count</dd>
            <dt>@Ui["Connection count"]</dt><dd>@(comparison.Saved?.Definition.Wires.Count??0) → @comparison.Draft.Document.Wires.Count</dd>
            <dt>@Ui["Activation after saving"]</dt><dd>@Ui[Activation switch
            {
                EActivationPolicy.Auto => "Activate after saving",
                EActivationPolicy.Explicit => "Save without activation",
                _ => "Confirm impact before activation"
            }]</dd>
        </dl>
        <details class="secondary-details">
            <summary>@Ui["Changed fields"] (@comparison.Differences.Count)</summary>
            @if(comparison.Saved is {} saved)
            {
                <p>@Ui["Full revision ID"] <code>@saved.Revision</code></p>
            }
            <ul>@foreach(var difference in comparison.Differences){<li><code>@difference.Path</code></li>}</ul>
            @if(comparison.Truncated){<p>@Ui["Only the first changes are shown. Export the definitions to review the complete contents."]</p>}
        </details>
    }
    <div class="toolbar">
        @if(force?.Review is {} export)
        {
            <button disabled="@(working||export.Saved is null)" @onclick="()=>ExportAsync(true,UiCancellation)">@Ui["Export saved version"]</button>
        }
        <button disabled="@working" @onclick="()=>ExportAsync(false,UiCancellation)">@Ui["Export current draft"]</button>
    </div>
    <p class="muted small">@Ui["The draft and overwritten version are backed up on this browser before sending. Validation, restore locks and concurrent-save checks still apply."]</p>
    @if(problem is not null){<p class="notice error" role="alert">@problem</p>}
    @if(force?.OperationId is {} operation){<p>@Ui["Operation"] · <code>@operation</code></p><button disabled="@working" @onclick="()=>SubmitAsync(true,UiCancellation)">@Ui["Look up original save"]</button>}
    @if(force?.Result is {} result){<p role="status">@Ui.Format("Saved: {0} / Shared: {1} / Snapshot: {2} / Active: {3}",Ui[result.Saved.Outcome.ToString()],Ui[result.Shared.Outcome.ToString()],Ui[result.Snapshot.Outcome.ToString()],Ui[result.Activation.Outcome.ToString()])</p><p>@result.Saved.Reason @result.Shared.Reason @result.Activation.Reason</p>}
    @if(force?.Result?.BeforeSnapshot is {} before){<p>@Ui.Format("Before-change snapshot: {0}",Ui[before.Outcome.ToString()]) · @force.Result.BeforeSnapshotId</p>}
    </ChildContent>
    <Actions>
        <button class="danger confirm-action" disabled="@(working||force?.Review is null||force.OperationId is not null)" @onclick="()=>SubmitAsync(false,UiCancellation)"><UiIcon Name="warning" /><span class="control-label">@Ui["Confirm overwrite and save"]</span></button>
    </Actions>
</Modal>
