@using ReArtWord.Contents.BackgroundService.Client.Components
<div class="path-input"><input type="text" disabled="@Disabled" value="@Value" @oninput="e=>ValueChanged.InvokeAsync(e.Value?.ToString()??string.Empty)" /><button type="button" disabled="@(Disabled||busy)" @onclick="()=>OpenAsync(UiCancellation)">@Ui["Select or register API key"]</button></div>
<Modal Open="open" Title="@Ui["API key stored in this cluster"]" Close="Close">
    <p>@Ui["Select a saved key name or paste an API key below to register it. The workflow stores only the name. Keys are shared within this cluster; no environment variable is implied."]</p>
    <p class="notice">@Ui[message]</p>
    <fieldset disabled="@(!CanEdit || busy)">
        <label>@Ui["Saved key name"]<select value="@name" @onchange="e=>name=e.Value?.ToString()??string.Empty"><option value="" selected="@(name.Length==0)">@Ui["Not set"]</option>@if(name.Length!=0&&!names.Contains(name,StringComparer.Ordinal)){<option value="@name" selected>@name — @Ui["Not in current choices"]</option>}@foreach(var item in names){<option @key="item" value="@item" selected="@(item==name)">@item</option>}</select></label>
        <button type="button" disabled="@(!names.Contains(name,StringComparer.Ordinal))" @onclick="()=>SelectAsync(UiCancellation)">@Ui["Use selected key"]</button>
        <label>@Ui["Name for this API key"]<input type="text" @bind="name" /></label>
        <label>@Ui["API key value"]<input type="password" autocomplete="new-password" @bind="secret" /></label>
        @if(names.Contains(name,StringComparer.Ordinal)){<p>@Ui["Saving replaces this named key for future executions in this cluster."]</p>}
        <button type="button" disabled="@(string.IsNullOrWhiteSpace(name)||string.IsNullOrWhiteSpace(secret))" @onclick="()=>SaveAsync(UiCancellation)">@Ui["Save key and use its name"]</button>
    </fieldset>
</Modal>
