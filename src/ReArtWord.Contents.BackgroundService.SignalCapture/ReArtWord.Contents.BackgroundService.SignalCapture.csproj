<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SignalCapture</AssemblyName>
    <RootNamespace>ReArtWord.Contents.BackgroundService.SignalCapture</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot Condition="'$(RuntimeIdentifier)' != ''">true</PublishAot>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ReArtWord.Contents.BackgroundService.Unit.Tests" />
  </ItemGroup>
</Project>
