<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- ネイティブ境界の実機試験用LibraryImportスタブで使用します。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/ProcessResourceSample.cs" Link="Performance/ProcessResourceSample.cs" />
    <Compile Include="../Shared/ApplicationProcessFixture.cs" Link="Processes/ApplicationProcessFixture.cs" />
    <Compile Include="../Shared/PublishedFixtureFile.cs" Link="Processes/PublishedFixtureFile.cs" />
    <Compile Include="../Shared/PerformanceTestGroup.cs" Link="Performance/PerformanceTestGroup.cs" />
    <Compile Include="../Shared/HostedDesktopFactAttribute.cs" Link="Management/HostedDesktopFactAttribute.cs" />
    <Compile Include="../Shared/HostedDesktopTheoryAttribute.cs" Link="Management/HostedDesktopTheoryAttribute.cs" />
    <!-- 実UDP・SQLite・外部processを使うfixture同士の同時数だけを制限し、fixture内部の並行試験は維持します。 -->
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="DeviceManagement/*.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../samples/scripting/normalize-labels.csx;../../samples/scripting/normalize-labels.py;../../samples/scripting/normalize-labels.mjs" Link="ScriptingSamples/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../samples/generic-communication/optional-http-status.csx" Link="optional-http-status.csx" CopyToOutputDirectory="PreserveNewest" />
    <Compile Remove="Updates/FixtureHost/**/*.cs" />
    <Compile Remove="Management/FixtureHost/**/*.cs" />
    <ProjectReference Include="../../src/ReArtWord.Contents.BackgroundService.CommandLine/ReArtWord.Contents.BackgroundService.CommandLine.csproj" />
    <ProjectReference Include="../../src/ReArtWord.Contents.BackgroundService.CoreService/ReArtWord.Contents.BackgroundService.CoreService.csproj" />
    <ProjectReference Include="../../src/ReArtWord.Contents.BackgroundService.SignalCapture/ReArtWord.Contents.BackgroundService.SignalCapture.csproj" />
    <ProjectReference Include="Updates/FixtureHost/FixtureHost.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="Management/FixtureHost/FixtureHost.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/ReArtWord.Contents.BackgroundService.Updater/ReArtWord.Contents.BackgroundService.Updater.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/ReArtWord.Contents.BackgroundService.Runtime/ReArtWord.Contents.BackgroundService.Runtime.csproj" />
    <ProjectReference Include="../../src/ReArtWord.Contents.BackgroundService.Nodes/ReArtWord.Contents.BackgroundService.Nodes.csproj" />
    <ProjectReference Include="../../src/ReArtWord.Contents.BackgroundService.Infrastructure/ReArtWord.Contents.BackgroundService.Infrastructure.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="CommandLine/FixtureHost/**" />
    <ProjectReference Include="CommandLine/FixtureHost/FixtureHost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
